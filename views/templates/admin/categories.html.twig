{# Lista kategorii bloga. #}
{% extends '@Modules/quince_engine/views/templates/admin/layout.html.twig' %}
{% import '@Modules/quince_engine/views/templates/admin/_macros/icons.html.twig' as icons %}

{% trans_default_domain 'Modules.Quinceblog.Admin' %}

{% block quince_actions %}
    <a class="qc-btn qc-btn-primary" href="{{ path('quince_blog_categories_edit', {'id': 0}) }}">
        {{ icons.icon('plus', 14) }} {{ 'New category'|trans }}
    </a>
{% endblock %}

{% block quince_body %}
<div class="qc-table-wrap">
    <table class="qc-table">
        <thead>
            <tr>
                <th>{{ 'Name'|trans }}</th>
                <th>{{ 'Active'|trans }}</th>
                <th>{{ 'Posts'|trans }}</th>
                <th style="width:80px"></th>
            </tr>
        </thead>
        <tbody>
            {% for cat in rows %}
                <tr>
                    <td>
                        {% if cat.id_parent %}<span class="qc-muted">— </span>{% endif %}
                        <a href="{{ path('quince_blog_categories_edit', {'id': cat.id_category}) }}"><strong>{{ cat.name }}</strong></a>
                        {% if cat.color %}<span style="display:inline-block;width:10px;height:10px;border-radius:50%;background:{{ cat.color }};margin-inline-start:6px;vertical-align:middle"></span>{% endif %}
                    </td>
                    <td>{% if cat.active %}<span class="qc-badge qc-badge-success">{{ 'Yes'|trans }}</span>{% else %}<span class="qc-badge">{{ 'No'|trans }}</span>{% endif %}</td>
                    <td>{{ cat.post_count }}</td>
                    <td>
                        <div class="qc-row-actions" style="opacity:1">
                            <a class="qc-icon-btn" href="{{ path('quince_blog_categories_edit', {'id': cat.id_category}) }}">{{ icons.icon('edit', 14) }}</a>
                            <form method="post" action="{{ path('quince_blog_categories_delete') }}" style="display:inline">
                                <input type="hidden" name="_csrf_token" value="{{ csrf_token('quince_blog_categories_delete') }}">
                                <input type="hidden" name="id" value="{{ cat.id_category }}">
                                <button type="submit" class="qc-icon-btn qc-danger" onclick="return confirm('{{ 'Remove this category?'|trans|e('js') }}')">
                                    {{ icons.icon('trash', 14) }}
                                </button>
                            </form>
                        </div>
                    </td>
                </tr>
            {% else %}
                <tr><td colspan="4"><div class="qc-empty"><div class="qc-empty-text">{{ 'No category yet.'|trans }}</div></div></td></tr>
            {% endfor %}
        </tbody>
    </table>
</div>
{% endblock %}
