{# Edycja kategorii bloga. #}
{% extends '@Modules/quince_engine/views/templates/admin/layout.html.twig' %}
{% import '@Modules/quince_engine/views/templates/admin/_macros/icons.html.twig' as icons %}
{% import '@Modules/quince_engine/views/templates/admin/_macros/fields.html.twig' as fields %}

{% trans_default_domain 'Modules.Quinceblog.Admin' %}

{% block javascripts %}
    {{ parent() }}
    <script src="{{ asset('../modules/quince_engine/views/js/vendor/alpine.min.js') ~ qcVer }}" defer></script>
{% endblock %}

{% block quince_actions %}
    <a class="qc-btn qc-btn-outline" href="{{ path('quince_blog_categories') }}">{{ 'Back to list'|trans }}</a>
    <button type="submit" form="quince-category-edit" class="qc-btn qc-btn-primary">
        {{ icons.icon('check', 14) }} {{ 'Save'|trans }}
    </button>
{% endblock %}

{% block quince_body %}
<form id="quince-category-edit" method="post" action="{{ path('quince_blog_categories_save') }}" class="qc-stack">
    <input type="hidden" name="_csrf_token" value="{{ csrf_token('quince_blog_categories_save') }}">
    <input type="hidden" name="id_category" value="{{ category.id_category|default(0) }}">

    <div class="qc-card">
        <div class="qc-card-body qc-stack">
            {% set names = {} %}
            {% set slugs = {} %}
            {% set descriptions = {} %}
            {% for lang in languages %}
                {% set names = names|merge({(lang.id_lang): category.lang[lang.id_lang].name|default('')}) %}
                {% set slugs = slugs|merge({(lang.id_lang): category.lang[lang.id_lang].slug|default('')}) %}
                {% set descriptions = descriptions|merge({(lang.id_lang): category.lang[lang.id_lang].description|default('')}) %}
            {% endfor %}

            {{ fields.multilang('name', 'Name'|trans, languages, names) }}
            {{ fields.multilang('slug', 'Slug'|trans, languages, slugs, '', 'Left empty, built from the name.'|trans) }}
            {{ fields.multilangArea('description', 'Description'|trans, languages, descriptions, '', '', 3) }}

            <div class="qc-form-grid qc-form-grid-2">
                <div class="qc-field">
                    <label class="qc-label" for="q-parent">{{ 'Parent category'|trans }}</label>
                    <div class="qc-select-wrap">
                        <select id="q-parent" name="id_parent" class="qc-field-base qc-select qc-focusable">
                            <option value="0">{{ '(top level)'|trans }}</option>
                            {% for p in parents %}
                                <option value="{{ p.id_category }}" {{ category.id_parent == p.id_category ? 'selected' }}>{{ p.name }}</option>
                            {% endfor %}
                        </select>
                        {{ icons.icon('chevronDown', 14, 'qc-select-chevron') }}
                    </div>
                </div>
                <div class="qc-field">
                    <label class="qc-label" for="q-color">{{ 'Colour (optional)'|trans }}</label>
                    <div style="display:flex; align-items:center; gap:10px">
                        <input type="color" id="q-color" class="qc-field-base qc-focusable" style="max-inline-size:80px"
                               name="color" value="{{ category.color|default('#fcc804') }}">
                        <label style="display:flex; align-items:center; gap:6px; font-weight:normal">
                            <input type="checkbox" class="qc-checkbox" name="color_enabled" value="1" {{ category.color ? 'checked' }}>
                            <span>{{ 'Use this colour'|trans }}</span>
                        </label>
                    </div>
                    <div class="qc-hint">{{ 'Shown as the category badge on post teasers. Leave unchecked to use the shop brand colour.'|trans }}</div>
                </div>
            </div>

            <div class="qc-field">
                {{ fields.toggle('active', category is null or category.active, 'Visible in the shop'|trans) }}
            </div>
        </div>
    </div>
</form>
{% endblock %}
