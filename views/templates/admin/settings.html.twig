{# Szerokość strony pojedynczego wpisu, w kolumnach ustawionych w silniku
   (Wygląd → liczba kolumn). Treść i zdjęcie osobno. #}
{% extends '@Modules/quince_engine/views/templates/admin/layout.html.twig' %}
{% import '@Modules/quince_engine/views/templates/admin/_macros/icons.html.twig' as icons %}
{% import '@Modules/quince_engine/views/templates/admin/_macros/fields.html.twig' as fields %}

{% trans_default_domain 'Modules.Quinceblog.Admin' %}

{# Pola wielojęzyczne przełączają język przez Alpine. #}
{% block javascripts %}
    {{ parent() }}
    <script src="{{ asset('../modules/quince_engine/views/js/vendor/alpine.min.js') ~ qcVer }}" defer></script>
{% endblock %}

{% block quince_intro %}
    <div class="qc-alert qc-alert-info">
        {{ icons.icon('info', 18, 'qc-alert-icon') }}
        <div>{{ 'The shop is currently set to %columns% columns (Design → Appearance). Pick how many of those columns the post text and the post cover each take up.'|trans({'%columns%': engineColumns}) }}</div>
    </div>
{% endblock %}

{% block quince_actions %}
    <button type="submit" form="quince-blog-settings" class="qc-btn qc-btn-primary">
        {{ icons.icon('check', 14) }} {{ 'Save changes'|trans }}
    </button>
{% endblock %}

{% block quince_body %}
<form id="quince-blog-settings" method="post" action="{{ path('quince_blog_settings_save') }}" class="qc-stack">
    <input type="hidden" name="_csrf_token" value="{{ csrf_token('quince_blog_settings_save') }}">
    <div class="qc-card">
        <div class="qc-card-head">
            <div><div class="qc-card-title">{{ 'Post page width'|trans }}</div></div>
        </div>
        <div class="qc-card-body qc-form-grid qc-form-grid-2">
            <div class="qc-field">
                <label class="qc-label">{{ 'Text width (columns)'|trans }}</label>
                <div class="qc-select-wrap">
                    <select class="qc-field-base qc-select qc-focusable" name="content_cols">
                        {% for n in 1..engineColumns %}
                            <option value="{{ n }}" {{ n == contentColumns ? 'selected' }}>{{ n }}</option>
                        {% endfor %}
                    </select>
                    {{ icons.icon('chevronDown', 14, 'qc-select-chevron') }}
                </div>
                <div class="qc-hint">{{ 'Title, body text, FAQ, related posts.'|trans }}</div>
            </div>
            <div class="qc-field">
                <label class="qc-label">{{ 'Cover image width (columns)'|trans }}</label>
                <div class="qc-select-wrap">
                    <select class="qc-field-base qc-select qc-focusable" name="image_cols">
                        {% for n in 1..engineColumns %}
                            <option value="{{ n }}" {{ n == imageColumns ? 'selected' }}>{{ n }}</option>
                        {% endfor %}
                    </select>
                    {{ icons.icon('chevronDown', 14, 'qc-select-chevron') }}
                </div>
                <div class="qc-hint">{{ 'Set it to %columns% for the full page width.'|trans({'%columns%': engineColumns}) }}</div>
            </div>
        </div>
    </div>

    <div class="qc-card">
        <div class="qc-card-head">
            <div><div class="qc-card-title">{{ 'Related posts'|trans }}</div></div>
        </div>
        <div class="qc-card-body">
            <div class="qc-field">
                <label class="qc-label">{{ 'How many to show under the post'|trans }}</label>
                <input type="number" min="1" max="6" class="qc-field-base qc-focusable" style="max-width:120px"
                       name="related_count" value="{{ relatedCount }}">
                <div class="qc-hint">{{ 'The teasers always stretch to fill the full text width, no matter the number.'|trans }}</div>
            </div>
        </div>
    </div>

    <div class="qc-card">
        <div class="qc-card-head">
            <div><div class="qc-card-title">{{ 'Blog in search results'|trans }}</div></div>
        </div>
        <div class="qc-card-body qc-stack">
            <div class="qc-hint">{{ 'Categories and posts have their own SEO fields, on their edit screens.'|trans }}</div>
            {{ fields.multilang('list_title', 'Blog home page title'|trans, languages, seo.list_title, '', 'The page with all posts. Shown in the browser tab and in search results. Left empty: “Blog”. The RSS feed uses the same title.'|trans) }}
            {{ fields.multilangArea('list_description', 'Blog home page description'|trans, languages, seo.list_description, '', 'Shown under the title in search results. Left empty: no description.'|trans, 2) }}
            {{ fields.multilang('tag_title', 'Tag page title'|trans, languages, seo.tag_title, '', '%tag% is replaced by the tag name. Left empty: “#tag name”.'|trans) }}
        </div>
    </div>
</form>
{% endblock %}
